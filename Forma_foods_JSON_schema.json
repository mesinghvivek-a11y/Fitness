{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://forma.example/schemas/foods.schema.json",
  "title": "Forma Master Food Catalogue",
  "description": "Validates the top-level foods.json array used by the current Forma PWA. The catalogue may contain raw ingredients, portion estimates, and preloaded custom_recipe records.",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "id",
      "name",
      "type",
      "serving_unit",
      "default_serving_size",
      "tags",
      "category"
    ],
    "properties": {
      "id": {
        "type": "string",
        "minLength": 1,
        "description": "Unique and stable identifier; never duplicate another food ID."
      },
      "name": {
        "type": "string",
        "minLength": 1
      },
      "type": {
        "enum": [
          "raw_ingredient",
          "standard_estimate",
          "custom_recipe"
        ]
      },
      "serving_unit": {
        "type": "string",
        "minLength": 1,
        "description": "Recommended: g for solids, ml for liquids, or a unit such as piece/bowl/serving for a prepared estimate."
      },
      "default_serving_size": {
        "type": "number",
        "exclusiveMinimum": 0
      },
      "macros_per_100g": {
        "$ref": "#/$defs/macros"
      },
      "macros_per_100ml": {
        "$ref": "#/$defs/macros"
      },
      "macros_per_serving": {
        "$ref": "#/$defs/macros"
      },
      "tags": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        },
        "uniqueItems": true
      },
      "category": {
        "type": "string",
        "minLength": 1
      },
      "subcategory": {
        "type": "string"
      },
      "data_source": {
        "type": "string"
      },
      "data_quality": {
        "type": "string"
      },
      "nutrient_fields_available": {
        "type": "array",
        "items": {
          "enum": [
            "calories",
            "protein",
            "carbs",
            "fat",
            "fiber"
          ]
        },
        "uniqueItems": true
      },
      "fiber_data_available": {
        "type": "boolean"
      },
      "image_url": {
        "type": "string"
      },
      "brand": {
        "type": "string"
      },
      "barcode": {
        "type": "string"
      },
      "product_quantity": {
        "type": "string"
      },
      "source_data_quality_flags": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "source_record_updated_from_csv": {
        "type": "boolean"
      },
      "source_carbs_original": {
        "type": "number"
      },
      "recipe_ingredients": {
        "type": "array",
        "minItems": 1,
        "description": "Ingredient breakdown for a recipe; food_id should match a food ID in the catalogue when available.",
        "items": {
          "type": "object",
          "required": [
            "food_id",
            "name",
            "amount",
            "unit",
            "macros"
          ],
          "properties": {
            "food_id": {
              "type": "string",
              "minLength": 1
            },
            "name": {
              "type": "string",
              "minLength": 1
            },
            "amount": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "unit": {
              "type": "string",
              "minLength": 1
            },
            "macros": {
              "$ref": "#/$defs/macros"
            },
            "food_snapshot": {
              "type": "object"
            }
          },
          "additionalProperties": true
        }
      },
      "yield": {
        "type": "integer",
        "minimum": 1,
        "description": "Number of servings produced by the complete recipe."
      },
      "created_at": {
        "type": "string",
        "format": "date-time"
      },
      "updated_at": {
        "type": "string",
        "format": "date-time"
      }
    },
    "additionalProperties": true,
    "allOf": [
      {
        "if": {
          "properties": {
            "type": {
              "const": "raw_ingredient"
            }
          },
          "required": [
            "type"
          ]
        },
        "then": {
          "oneOf": [
            {
              "required": [
                "macros_per_100g"
              ],
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "macros_per_100ml"
                    ]
                  },
                  {
                    "required": [
                      "macros_per_serving"
                    ]
                  }
                ]
              }
            },
            {
              "required": [
                "macros_per_100ml"
              ],
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "macros_per_100g"
                    ]
                  },
                  {
                    "required": [
                      "macros_per_serving"
                    ]
                  }
                ]
              }
            }
          ]
        }
      },
      {
        "if": {
          "properties": {
            "type": {
              "const": "standard_estimate"
            }
          },
          "required": [
            "type"
          ]
        },
        "then": {
          "required": [
            "macros_per_serving"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "macros_per_100g"
                ]
              },
              {
                "required": [
                  "macros_per_100ml"
                ]
              }
            ]
          }
        }
      },
      {
        "if": {
          "properties": {
            "type": {
              "const": "custom_recipe"
            }
          },
          "required": [
            "type"
          ]
        },
        "then": {
          "required": [
            "macros_per_serving",
            "recipe_ingredients",
            "yield"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "macros_per_100g"
                ]
              },
              {
                "required": [
                  "macros_per_100ml"
                ]
              }
            ]
          }
        }
      }
    ]
  },
  "$defs": {
    "nutrient": {
      "type": "number",
      "minimum": 0
    },
    "macros": {
      "type": "object",
      "required": [
        "calories",
        "protein",
        "carbs",
        "fat"
      ],
      "properties": {
        "calories": {
          "$ref": "#/$defs/nutrient"
        },
        "protein": {
          "$ref": "#/$defs/nutrient"
        },
        "carbs": {
          "$ref": "#/$defs/nutrient"
        },
        "fat": {
          "$ref": "#/$defs/nutrient"
        },
        "fiber": {
          "$ref": "#/$defs/nutrient"
        }
      },
      "additionalProperties": false
    }
  }
}
